<%# Parameter: action, log, back %>
<form method="post" action="<%= action %>" class="review-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="back" value="<%= back %>">
  <textarea name="feedback" rows="2" placeholder="Catatan untuk mahasiswa (wajib bila perlu revisi)"><%= log.feedback || '' %></textarea>
  <div class="actions">
    <button type="submit" name="status" value="disetujui" class="btn btn-small btn-primary">Setujui</button>
    <button type="submit" name="status" value="revisi" class="btn btn-small btn-warning">Minta revisi</button>
    <% if (log.status !== 'menunggu') { %>
      <button type="submit" name="status" value="menunggu" class="btn btn-small">Batalkan</button>
    <% } %>
  </div>
</form>
