<%- include('partials/header') %>
<section class="login">
  <div class="login-intro">
    <h1>Logbook Kewirausahaan</h1>
    <p>Dokumentasi kegiatan usaha dan ruang belajar untuk mahasiswa dan dosen pembimbing.</p>
  </div>
  <form method="post" action="/login" class="card">
    <h2>Masuk</h2>
    <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>NIM / NIDN
      <input name="username" value="<%= username %>" autocomplete="username" required autofocus>
    </label>
    <label>Kata sandi
      <input type="password" name="password" autocomplete="current-password" required>
    </label>
    <button class="btn btn-primary btn-block" type="submit">Masuk</button>
    <p class="small muted">Mahasiswa masuk dengan NIM, dosen dengan NIDN/NIP. Lupa kata sandi? Hubungi dosen pengampu.</p>
  </form>
</section>
<%- include('partials/footer') %>
