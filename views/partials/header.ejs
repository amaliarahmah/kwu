<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Logbook KWU</title>
  <link rel="stylesheet" href="/static/css/style.css">
</head>
<body>
<% if (user) {
  const nav = user.role === 'dosen'
    ? [['/dosen', 'Dashboard'], ['/dosen/antrian', 'Pemeriksaan'], ['/dosen/materi', 'Materi'], ['/dosen/kelola', 'Kelola Data']]
    : [['/mahasiswa', 'Beranda'], ['/mahasiswa/log-pribadi', 'Log Pribadi'], ['/mahasiswa/log-kelompok', 'Log Kelompok'],
       ['/mahasiswa/dokumen', 'Dokumen'], ['/mahasiswa/materi', 'Materi'], ['/mahasiswa/rekap', 'Rekap']];
  const base = user.role === 'dosen' ? '/dosen' : '/mahasiswa';
%>
<header class="topbar no-print">
  <div class="topbar-inner">
    <a class="brand" href="/">Logbook <strong>KWU</strong></a>
    <nav class="mainnav" aria-label="Menu utama">
      <% nav.forEach(([href, label]) => {
        const active = href === base ? currentPath.replace(/\/$/, '') === base : currentPath.startsWith(href); %>
        <a href="<%= href %>" class="<%= active ? 'active' : '' %>"><%= label %></a>
      <% }) %>
    </nav>
    <details class="account">
      <summary><%= user.name %> <span class="role"><%= user.role === 'dosen' ? 'Dosen' : 'Mahasiswa' %></span></summary>
      <div class="account-menu">
        <span class="muted small"><%= user.username %><%= user.group_name ? ' · ' + user.group_name : '' %></span>
        <a href="/akun/password">Ubah kata sandi</a>
        <form method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="link-button" type="submit">Keluar</button>
        </form>
      </div>
    </details>
  </div>
</header>
<% } %>
<main class="container">
<% if (flash) { %>
  <div class="alert alert-<%= flash.type %>" role="status"><%= flash.message %></div>
<% } %>
