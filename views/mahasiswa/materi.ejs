<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <h1>Topik &amp; Materi Pembelajaran</h1>
    <p class="muted">Pelajari materi sesuai urutan minggu dan tandai yang sudah selesai.</p>
  </div>
  <div class="progress-box">
    <span class="small muted"><%= done %> dari <%= total %> materi selesai</span>
    <div class="progress"><span style="width: <%= total ? Math.round(done / total * 100) : 0 %>%"></span></div>
  </div>
</div>
<% if (!topics.length) { %><p class="card muted">Dosen belum menambahkan topik pembelajaran.</p><% } %>
<% topics.forEach(t => { %>
  <section class="card topic">
    <div class="topic-head">
      <% if (t.week_no) { %><span class="chip">Minggu <%= t.week_no %></span><% } %>
      <h2><%= t.title %></h2>
    </div>
    <%- include('../partials/multiline', { text: t.description }) %>
    <% if (!t.materials.length) { %><p class="small muted">Belum ada materi pada topik ini.</p><% } else { %>
      <ul class="material-list">
        <% t.materials.forEach(m => { %>
          <li class="<%= m.completed_at ? 'done' : '' %>">
            <span class="check" aria-hidden="true"><%= m.completed_at ? '✓' : '' %></span>
            <a href="/mahasiswa/materi/<%= m.id %>"><%= m.title %></a>
            <span class="small muted"><%= [m.original_name ? 'lampiran' : null, m.link_url ? 'tautan' : null].filter(Boolean).join(' · ') %></span>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
<% }) %>
<%- include('../partials/footer') %>
