<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <h1>Log Pribadi</h1>
    <p class="muted">Catat kegiatan kewirausahaan yang Anda lakukan secara individu.</p>
  </div>
</div>
<div class="layout-split">
  <section class="card" id="form">
    <h2><%= editing ? 'Ubah log' : 'Tambah log baru' %></h2>
    <%- include('../partials/errors') %>
    <form method="post" action="/mahasiswa/log-pribadi<%= editing ? '/' + editing.id : '' %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <%- include('../partials/log-fields', { form, withAttendees: false }) %>
      <div class="actions">
        <button class="btn btn-primary" type="submit"><%= editing ? 'Simpan perubahan' : 'Simpan log' %></button>
        <% if (editing) { %><a class="btn" href="/mahasiswa/log-pribadi">Batal</a><% } %>
      </div>
      <% if (editing && editing.status === 'revisi') { %>
        <p class="small muted">Setelah disimpan, status log kembali menjadi "Menunggu" untuk diperiksa ulang.</p>
      <% } %>
    </form>
  </section>
  <section>
    <h2><%= logs.length %> log tercatat</h2>
    <% if (!logs.length) { %><p class="muted card">Belum ada log. Mulai dengan mengisi formulir.</p><% } %>
    <% logs.forEach(log => { %>
      <%- include('../partials/log-item', {
        log, showAuthor: false, canEdit: log.status !== 'disetujui',
        editUrl: `/mahasiswa/log-pribadi?edit=${log.id}#form`, deleteUrl: `/mahasiswa/log-pribadi/${log.id}/hapus`
      }) %>
    <% }) %>
  </section>
</div>
<%- include('../partials/footer') %>
