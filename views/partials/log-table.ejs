<%# Tabel log ringkas. Parameter: rows, showAuthor %>
<% if (!rows.length) { %><p class="muted">Belum ada log.</p><% } else { %>
<div class="table-wrap">
  <table>
    <thead><tr><th>Tanggal</th><th>Kegiatan</th><th>Hasil</th><% if (showAuthor) { %><th>Penulis</th><% } %><th class="num">Durasi</th><th>Status</th></tr></thead>
    <tbody>
    <% rows.slice().sort((a, b) => a.log_date.localeCompare(b.log_date)).forEach(l => { %>
      <tr>
        <td class="nowrap"><%= formatDate(l.log_date) %></td>
        <td><strong><%= l.activity %></strong><% if (l.description) { %><div class="small clamp"><%= l.description %></div><% } %></td>
        <td class="small"><%= l.outcome || '-' %></td>
        <% if (showAuthor) { %><td class="small"><%= l.author_name || '-' %></td><% } %>
        <td class="num nowrap"><%= formatHours(l.duration_hours) %></td>
        <td><%- include('status', { status: l.status }) %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<% } %>
