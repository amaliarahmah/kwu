<%# Satu entri log. Parameter: log, canEdit, editUrl, deleteUrl, showAuthor %>
<article class="log-item">
  <header>
    <div>
      <span class="log-date"><%= formatDate(log.log_date) %></span>
      <h3><%= log.activity %></h3>
      <span class="small muted">
        <%= formatHours(log.duration_hours) %>
        <% if (showAuthor) { %> · ditulis <%= log.author_name || 'anggota' %><% } %>
        <% if (log.attendees) { %> · hadir: <%= log.attendees %><% } %>
      </span>
    </div>
    <%- include('status', { status: log.status }) %>
  </header>
  <% if (log.description) { %><h4>Uraian</h4><%- include('multiline', { text: log.description }) %><% } %>
  <% if (log.outcome) { %><h4>Hasil / pembelajaran</h4><%- include('multiline', { text: log.outcome }) %><% } %>
  <% if (log.feedback) { %>
    <div class="feedback"><strong>Catatan dosen:</strong><%- include('multiline', { text: log.feedback }) %></div>
  <% } %>
  <% if (canEdit) { %>
    <div class="actions">
      <a class="btn btn-small" href="<%= editUrl %>">Ubah</a>
      <form method="post" action="<%= deleteUrl %>" onsubmit="return confirm('Hapus log ini?')">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-small btn-danger" type="submit">Hapus</button>
      </form>
    </div>
  <% } %>
</article>
