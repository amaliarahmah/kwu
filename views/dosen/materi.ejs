<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <h1>Materi Pembelajaran</h1>
    <p class="muted">Susun topik per minggu, lalu isi dengan materi: teks, tautan (video/artikel), atau file lampiran.</p>
  </div>
  <div class="actions"><a class="btn btn-primary" href="/dosen/materi/baru">+ Tambah materi</a></div>
</div>

<details class="card" <%= topics.length ? '' : 'open' %>>
  <summary><strong>+ Tambah topik</strong></summary>
  <form method="post" action="/dosen/topik" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="grid-2">
      <label>Judul topik <input name="title" maxlength="200" required placeholder="mis. Validasi Ide Bisnis"></label>
      <label>Minggu ke- (opsional) <input type="number" name="week_no" min="1" max="52"></label>
    </div>
    <label>Deskripsi / tujuan pembelajaran <textarea name="description" rows="3"></textarea></label>
    <button class="btn btn-primary" type="submit">Simpan topik</button>
  </form>
</details>

<% topics.forEach(t => { %>
  <section class="card topic">
    <div class="topic-head">
      <% if (t.week_no) { %><span class="chip">Minggu <%= t.week_no %></span><% } %>
      <h2><%= t.title %></h2>
      <a class="btn btn-small" href="/dosen/materi/baru?topik=<%= t.id %>">+ Materi</a>
    </div>
    <%- include('../partials/multiline', { text: t.description }) %>
    <% if (!t.materials.length) { %><p class="small muted">Belum ada materi.</p><% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Materi</th><th>Isi</th><th class="num">Selesai dipelajari</th><th></th></tr></thead>
        <tbody>
        <% t.materials.forEach(m => { %>
          <tr>
            <td><strong><%= m.title %></strong></td>
            <td class="small"><%= [m.content ? 'teks' : null, m.link_url ? 'tautan' : null, m.original_name ? 'lampiran' : null].filter(Boolean).join(', ') %></td>
            <td class="num"><%= m.done_count %> / <%= studentCount %></td>
            <td class="nowrap actions">
              <a class="btn btn-small" href="/dosen/materi/<%= m.id %>/ubah">Ubah</a>
              <form method="post" action="/dosen/materi/<%= m.id %>/hapus" onsubmit="return confirm('Hapus materi ini?')">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-small btn-danger" type="submit">Hapus</button>
              </form>
            </td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
    <details>
      <summary class="small">Ubah / hapus topik</summary>
      <form method="post" action="/dosen/topik/<%= t.id %>" class="stack">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="grid-2">
          <label>Judul <input name="title" maxlength="200" value="<%= t.title %>" required></label>
          <label>Minggu ke- <input type="number" name="week_no" min="1" max="52" value="<%= t.week_no ?? '' %>"></label>
        </div>
        <label>Deskripsi <textarea name="description" rows="3"><%= t.description || '' %></textarea></label>
        <button class="btn btn-small btn-primary" type="submit">Simpan</button>
      </form>
      <form method="post" action="/dosen/topik/<%= t.id %>/hapus" onsubmit="return confirm('Hapus topik beserta semua materinya?')">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-small btn-danger" type="submit">Hapus topik</button>
      </form>
    </details>
  </section>
<% }) %>
<%- include('../partials/footer') %>
