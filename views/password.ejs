<%- include('partials/header') %>
<section class="card narrow">
  <h1>Ubah kata sandi</h1>
  <% if (user.must_change_password) { %>
    <div class="alert alert-info">Anda masuk dengan kata sandi sementara. Buat kata sandi baru untuk melanjutkan.</div>
  <% } %>
  <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
  <form method="post" action="/akun/password">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Kata sandi lama <input type="password" name="current" autocomplete="current-password" required></label>
    <label>Kata sandi baru (min. 8 karakter) <input type="password" name="next" minlength="8" autocomplete="new-password" required></label>
    <label>Ulangi kata sandi baru <input type="password" name="confirm" minlength="8" autocomplete="new-password" required></label>
    <button class="btn btn-primary" type="submit">Simpan</button>
  </form>
</section>
<%- include('partials/footer') %>
