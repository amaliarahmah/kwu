<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <h1>Dashboard Kelengkapan Log</h1>
    <p class="muted">
      <%= settings.program_name %> ·
      <% if (progress.currentWeek) { %>Minggu ke-<%= progress.currentWeek %> dari <%= settings.period_weeks %><% } else if (progress.finished) { %>Periode telah berakhir<% } else { %>Periode belum dimulai (mulai <%= formatDate(settings.period_start) %>)<% } %>
      · dinilai dari <%= progress.completedWeeks %> minggu yang sudah selesai
    </p>
  </div>
  <div class="actions">
    <a class="btn" href="/dosen/antrian">Pemeriksaan (<%= pendingTotal %>)</a>
    <a class="btn" href="/dosen/dashboard.csv?lingkup=<%= scope %><%= groupFilter ? '&kelompok=' + groupFilter : '' %>">Unduh CSV</a>
  </div>
</div>

<form method="get" action="/dosen" class="filters card">
  <label>Lingkup
    <select name="lingkup" onchange="this.form.submit()">
      <option value="semua">Semua kelompok</option>
      <option value="bimbingan" <%= scope === 'bimbingan' ? 'selected' : '' %>>Kelompok bimbingan saya</option>
    </select>
  </label>
  <label>Kelompok
    <select name="kelompok" onchange="this.form.submit()">
      <option value="">Semua</option>
      <% allGroups.forEach(g => { %><option value="<%= g.id %>" <%= groupFilter === g.id ? 'selected' : '' %>><%= g.name %></option><% }) %>
    </select>
  </label>
  <noscript><button class="btn" type="submit">Terapkan</button></noscript>
  <p class="small muted">Target per minggu: <%= settings.min_personal_logs_per_week %> log pribadi, <%= settings.min_group_logs_per_week %> log kelompok.
    Lengkap ≥ 80%, Kurang 50–79%, Tertinggal &lt; 50%.</p>
</form>

<% const levelOrder = [['baik', 'Lengkap'], ['sedang', 'Kurang'], ['rendah', 'Tertinggal'], ['na', 'Belum dinilai']]; %>
<div class="stats">
  <div class="stat">
    <span class="stat-label">Mahasiswa</span>
    <span class="stat-value"><%= students.length %></span>
    <div class="level-row"><% levelOrder.forEach(([k, l]) => { if (studentLevels[k]) { %><span class="badge level-<%= k %>"><%= studentLevels[k] %> <%= l %></span><% } }) %></div>
  </div>
  <div class="stat">
    <span class="stat-label">Kelompok</span>
    <span class="stat-value"><%= groups.length %></span>
    <div class="level-row"><% levelOrder.forEach(([k, l]) => { if (groupLevels[k]) { %><span class="badge level-<%= k %>"><%= groupLevels[k] %> <%= l %></span><% } }) %></div>
  </div>
  <div class="stat <%= pendingTotal ? 'stat-warn' : '' %>">
    <span class="stat-label">Log menunggu pemeriksaan</span>
    <span class="stat-value"><%= pendingTotal %></span>
    <a class="small" href="/dosen/antrian">Periksa sekarang →</a>
  </div>
  <div class="stat">
    <span class="stat-label">Materi tersedia</span>
    <span class="stat-value"><%= materialTotal %></span>
    <a class="small" href="/dosen/materi">Kelola materi →</a>
  </div>
</div>

<section class="card flush">
  <h2 class="pad">Kelengkapan log individu</h2>
  <% if (!students.length) { %><p class="pad muted">Belum ada mahasiswa. <a href="/dosen/kelola#mahasiswa">Tambahkan mahasiswa</a>.</p><% } else { %>
  <div class="table-wrap">
    <table>
      <thead><tr>
        <th>Mahasiswa</th><th>Kelompok</th><th class="num">Log</th><th class="num">Minggu terpenuhi</th>
        <th>Kelengkapan</th><th class="num">Menunggu</th><th class="num">Dokumen</th><th class="num">Materi</th><th>Log terakhir</th>
      </tr></thead>
      <tbody>
      <% students.forEach(s => { %>
        <tr>
          <td><a href="/dosen/mahasiswa/<%= s.id %>"><%= s.name %></a><div class="small muted"><%= s.username %></div></td>
          <td><%= s.group_name || '-' %></td>
          <td class="num"><%= s.stats.total %></td>
          <td class="num"><%= s.stats.weeksMet %> / <%= s.stats.completedWeeks %></td>
          <td>
            <div class="meter" title="<%= s.stats.level.label %>">
              <span class="meter-bar level-bg-<%= s.stats.level.key %>" style="width: <%= s.stats.percent ?? 0 %>%"></span>
            </div>
            <span class="small"><%= s.stats.percent === null ? '–' : s.stats.percent + '%' %> · <%= s.stats.level.label %></span>
          </td>
          <td class="num"><%= s.stats.pending || '' %></td>
          <td class="num"><%= s.documents %></td>
          <td class="num"><%= s.materialsDone %>/<%= materialTotal %></td>
          <td class="nowrap"><%= s.stats.lastDate ? formatDate(s.stats.lastDate) : '-' %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>

<section class="card flush">
  <h2 class="pad">Kelengkapan log kelompok</h2>
  <% if (!groups.length) { %><p class="pad muted">Belum ada kelompok.</p><% } else { %>
  <div class="table-wrap">
    <table>
      <thead><tr>
        <th>Kelompok</th><th>Pembimbing</th><th class="num">Anggota</th><th class="num">Log</th>
        <th class="num">Minggu terpenuhi</th><th>Kelengkapan</th><th class="num">Menunggu</th><th class="num">Dokumen</th><th>Log terakhir</th>
      </tr></thead>
      <tbody>
      <% groups.forEach(g => { %>
        <tr>
          <td><a href="/dosen/kelompok/<%= g.id %>"><%= g.name %></a><div class="small muted"><%= g.business_name || '' %></div></td>
          <td class="small"><%= g.mentor_name || '-' %></td>
          <td class="num"><%= g.member_count %></td>
          <td class="num"><%= g.stats.total %></td>
          <td class="num"><%= g.stats.weeksMet %> / <%= g.stats.completedWeeks %></td>
          <td>
            <div class="meter"><span class="meter-bar level-bg-<%= g.stats.level.key %>" style="width: <%= g.stats.percent ?? 0 %>%"></span></div>
            <span class="small"><%= g.stats.percent === null ? '–' : g.stats.percent + '%' %> · <%= g.stats.level.label %></span>
          </td>
          <td class="num"><%= g.stats.pending || '' %></td>
          <td class="num"><%= g.documents %></td>
          <td class="nowrap"><%= g.stats.lastDate ? formatDate(g.stats.lastDate) : '-' %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>
<%- include('../partials/footer') %>
