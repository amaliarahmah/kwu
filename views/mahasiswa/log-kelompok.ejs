<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <h1>Log Kelompok</h1>
    <% if (group) { %>
      <p class="muted">Kelompok <strong><%= group.name %></strong><%= group.business_name ? ' — ' + group.business_name : '' %> · Pembimbing: <%= group.mentor_name || 'belum ditentukan' %></p>
    <% } %>
  </div>
</div>
<% if (!group) { %>
  <div class="card"><p>Anda belum terdaftar dalam kelompok usaha. Hubungi dosen pengampu agar dimasukkan ke kelompok.</p></div>
<% } else { %>
<p class="small muted">Anggota: <%= members.map(m => m.name).join(', ') %></p>
<div class="layout-split">
  <section class="card" id="form">
    <h2><%= editing ? 'Ubah log kelompok' : 'Tambah log kelompok' %></h2>
    <%- include('../partials/errors') %>
    <form method="post" action="/mahasiswa/log-kelompok<%= editing ? '/' + editing.id : '' %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <%- include('../partials/log-fields', { form, withAttendees: true }) %>
      <div class="actions">
        <button class="btn btn-primary" type="submit"><%= editing ? 'Simpan perubahan' : 'Simpan log' %></button>
        <% if (editing) { %><a class="btn" href="/mahasiswa/log-kelompok">Batal</a><% } %>
      </div>
      <p class="small muted">Semua anggota dapat melihat log kelompok; hanya penulis yang dapat mengubah atau menghapusnya.</p>
    </form>
  </section>
  <section>
    <h2><%= logs.length %> log kelompok</h2>
    <% if (!logs.length) { %><p class="muted card">Belum ada log kelompok.</p><% } %>
    <% logs.forEach(log => { %>
      <%- include('../partials/log-item', {
        log, showAuthor: true, canEdit: log.author_id === user.id && log.status !== 'disetujui',
        editUrl: `/mahasiswa/log-kelompok?edit=${log.id}#form`, deleteUrl: `/mahasiswa/log-kelompok/${log.id}/hapus`
      }) %>
    <% }) %>
  </section>
</div>
<% } %>
<%- include('../partials/footer') %>
