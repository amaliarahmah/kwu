<%- include('../partials/header') %>
<p class="small"><a href="/dosen">← Dashboard</a></p>
<div class="page-head">
  <div>
    <h1><%= student.name %></h1>
    <p class="muted"><%= student.username %><%= student.prodi ? ' · ' + student.prodi : '' %> ·
      <% if (student.group_id) { %>Kelompok <a href="/dosen/kelompok/<%= student.group_id %>"><%= student.group_name %></a><% } else { %>Tanpa kelompok<% } %></p>
  </div>
  <div class="stat compact">
    <span class="stat-label">Kelengkapan</span>
    <span class="stat-value"><%= stats.percent === null ? '–' : stats.percent + '%' %></span>
    <span class="badge level-<%= stats.level.key %>"><%= stats.level.label %></span>
  </div>
</div>
<section class="card">
  <h2>Log pribadi per minggu</h2>
  <%- include('../partials/weeks', { weeks: stats.weeks }) %>
</section>
<div class="layout-split wide-right">
  <aside>
    <section class="card">
      <h2>Dokumen (<%= documents.length %>)</h2>
      <%- include('../partials/doc-table', { documents, showOwner: false }) %>
    </section>
    <section class="card">
      <h2>Materi</h2>
      <p class="small muted"><%= materials.filter(m => m.completed_at).length %> dari <%= materials.length %> selesai</p>
      <ul class="material-list compact">
        <% materials.forEach(m => { %><li class="<%= m.completed_at ? 'done' : '' %>"><span class="check"><%= m.completed_at ? '✓' : '' %></span><%= m.title %></li><% }) %>
      </ul>
    </section>
  </aside>
  <section>
    <h2>Log pribadi (<%= logs.length %>)</h2>
    <%- include('../partials/review-list', { logs, reviewBase: '/dosen/log-pribadi', back: `/dosen/mahasiswa/${student.id}`, showAuthor: false }) %>
  </section>
</div>
<%- include('../partials/footer') %>
