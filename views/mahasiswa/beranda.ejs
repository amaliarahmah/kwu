<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <h1>Halo, <%= user.name.split(' ')[0] %></h1>
    <p class="muted"><%= settings.program_name %> · <%= group ? `Kelompok ${group.name}${group.business_name ? ' — ' + group.business_name : ''}` : 'Belum tergabung dalam kelompok' %></p>
  </div>
  <div class="actions">
    <a class="btn btn-primary" href="/mahasiswa/log-pribadi">+ Isi log pribadi</a>
    <% if (group) { %><a class="btn" href="/mahasiswa/log-kelompok">+ Isi log kelompok</a><% } %>
  </div>
</div>

<% const pLevel = completenessLevel(personal.percent); %>
<div class="stats">
  <div class="stat">
    <span class="stat-label">Kelengkapan log pribadi</span>
    <span class="stat-value"><%= personal.percent === null ? '–' : personal.percent + '%' %></span>
    <span class="badge level-<%= pLevel.key %>"><%= pLevel.label %></span>
  </div>
  <div class="stat">
    <span class="stat-label">Minggu berjalan</span>
    <span class="stat-value"><%= personal.currentWeek ? personal.currentWeek : '–' %><small> / <%= settings.period_weeks %></small></span>
    <span class="small muted">
      <% if (personal.currentWeek) { const w = personal.weeks[personal.currentWeek - 1]; %>
        <%= w.count %> dari <%= settings.min_personal_logs_per_week %> log minggu ini
      <% } else { %>Di luar periode kegiatan<% } %>
    </span>
  </div>
  <div class="stat">
    <span class="stat-label">Materi dipelajari</span>
    <span class="stat-value"><%= materialsDone %><small> / <%= materialsTotal %></small></span>
    <a class="small" href="/mahasiswa/materi">Buka materi →</a>
  </div>
  <div class="stat <%= revisionCount ? 'stat-warn' : '' %>">
    <span class="stat-label">Log perlu revisi</span>
    <span class="stat-value"><%= revisionCount %></span>
    <span class="small muted">dari catatan dosen</span>
  </div>
</div>

<section class="card">
  <h2>Log pribadi per minggu</h2>
  <p class="small muted">Target: minimal <%= settings.min_personal_logs_per_week %> log per minggu. Periode mulai <%= formatDate(settings.period_start) %>.</p>
  <%- include('../partials/weeks', { weeks: personal.weeks }) %>
</section>

<% if (groupStats) { %>
<section class="card">
  <h2>Log kelompok per minggu</h2>
  <p class="small muted">Target: minimal <%= settings.min_group_logs_per_week %> log kelompok per minggu. Pembimbing: <%= group.mentor_name || 'belum ditentukan' %>.</p>
  <%- include('../partials/weeks', { weeks: groupStats.weeks }) %>
</section>
<% } %>

<section class="card">
  <h2>Catatan dosen terbaru</h2>
  <% if (!recentFeedback.length) { %>
    <p class="muted">Belum ada catatan dari dosen.</p>
  <% } else { %>
    <ul class="feed">
      <% recentFeedback.forEach(f => { %>
        <li>
          <div><strong><%= f.activity %></strong> <span class="muted small">· <%= f.kind %> · <%= formatDate(f.log_date) %></span>
            <%- include('../partials/status', { status: f.status }) %></div>
          <%- include('../partials/multiline', { text: f.feedback }) %>
          <a class="small" href="<%= f.link %>">Lihat log →</a>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>
<%- include('../partials/footer') %>
