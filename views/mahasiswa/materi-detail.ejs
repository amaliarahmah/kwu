<%- include('../partials/header') %>
<p class="small"><a href="/mahasiswa/materi">← Semua materi</a></p>
<article class="card material">
  <p class="muted small"><%= material.week_no ? `Minggu ${material.week_no} · ` : '' %><%= material.topic_title %></p>
  <h1><%= material.title %></h1>
  <%- include('../partials/multiline', { text: material.content }) %>
  <% if (material.link_url) { %>
    <p><a class="btn" href="<%= material.link_url %>" target="_blank" rel="noopener noreferrer">Buka tautan materi ↗</a></p>
  <% } %>
  <% if (material.stored_name) { %>
    <p><a class="btn" href="/unduh/materi/<%= material.id %>">Unduh lampiran: <%= material.original_name %> (<%= formatSize(material.size) %>)</a></p>
  <% } %>
  <form method="post" action="/mahasiswa/materi/<%= material.id %>/selesai" class="done-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% if (material.completed_at) { %>
      <input type="hidden" name="done" value="0">
      <span class="badge level-baik">Selesai dipelajari <%= formatDate(material.completed_at) %></span>
      <button class="btn btn-small" type="submit">Tandai belum selesai</button>
    <% } else { %>
      <input type="hidden" name="done" value="1">
      <button class="btn btn-primary" type="submit">Tandai sudah dipelajari</button>
    <% } %>
  </form>
</article>
<%- include('../partials/footer') %>
