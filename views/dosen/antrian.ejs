<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <h1>Antrian Pemeriksaan Log</h1>
    <p class="muted">Log berstatus "Menunggu", diurutkan dari yang paling lama.</p>
  </div>
</div>
<div class="layout-cols">
  <section>
    <h2>Log pribadi (<%= personal.length %>)</h2>
    <% if (!personal.length) { %><p class="card muted">Tidak ada log pribadi yang menunggu.</p><% } %>
    <% personal.forEach(log => { %>
      <article class="log-item">
        <header>
          <div>
            <span class="log-date"><%= formatDate(log.log_date) %></span>
            <h3><%= log.activity %></h3>
            <span class="small muted"><a href="/dosen/mahasiswa/<%= log.user_id %>"><%= log.student_name %></a> · <%= log.username %><%= log.group_name ? ' · ' + log.group_name : '' %> · <%= formatHours(log.duration_hours) %></span>
          </div>
        </header>
        <%- include('../partials/multiline', { text: log.description }) %>
        <% if (log.outcome) { %><h4>Hasil</h4><%- include('../partials/multiline', { text: log.outcome }) %><% } %>
        <%- include('../partials/review-form', { action: `/dosen/log-pribadi/${log.id}/review`, log, back: '/dosen/antrian' }) %>
      </article>
    <% }) %>
  </section>
  <section>
    <h2>Log kelompok (<%= group.length %>)</h2>
    <% if (!group.length) { %><p class="card muted">Tidak ada log kelompok yang menunggu.</p><% } %>
    <% group.forEach(log => { %>
      <article class="log-item">
        <header>
          <div>
            <span class="log-date"><%= formatDate(log.log_date) %></span>
            <h3><%= log.activity %></h3>
            <span class="small muted"><a href="/dosen/kelompok/<%= log.group_id %>"><%= log.group_name %></a> · oleh <%= log.author_name || '-' %> · <%= formatHours(log.duration_hours) %></span>
          </div>
        </header>
        <%- include('../partials/multiline', { text: log.description }) %>
        <% if (log.outcome) { %><h4>Hasil</h4><%- include('../partials/multiline', { text: log.outcome }) %><% } %>
        <% if (log.attendees) { %><p class="small muted">Hadir: <%= log.attendees %></p><% } %>
        <%- include('../partials/review-form', { action: `/dosen/log-kelompok/${log.id}/review`, log, back: '/dosen/antrian' }) %>
      </article>
    <% }) %>
  </section>
</div>
<%- include('../partials/footer') %>
